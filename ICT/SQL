-- 3. 		Executing SQL queries
-- a.	Get a list of all companies and the number of their vehicles:
-- 		i.	Usethe SELECTandJOIN statementto mergethe companiesandvehicles tables. 		Display the company name and the number of vehicles owned by each company.
SELECT c.company_name, COUNT(v.vehicle_id) AS number_of_vehicles
FROM companies c
LEFT JOIN vehicles v ON c.company_id = v.company_id
GROUP BY c.company_id, c.company_name;

-- b.	Get a list of all companies whose names start with the letter 'A':
SELECT company_name
FROM companies
WHERE company_name LIKE 'A%';

-- c.	Get a list of all cities with country IDs from 3 to 10:
SELECT city_name, country_id
FROM cities
WHERE country_id BETWEEN 3 AND 10;

-- d.	Get a list of all vehicles and their types:
SELECT vehicle_id, vehicle_type
FROM vehicles;

-- e.	Get a list of all routes and their corresponding cities:
SELECT r.route_id, c.city_name
FROM routes r
JOIN cities c ON r.city_id = c.city_id;

-- f.	First, show the transport_types table. After that, increase the average speed of all types of transport, if it is less than 100. Next, show the result.
SELECT * FROM transport_types;
UPDATE transport_types
SET average_speed = average_speed + 10
WHERE average_speed < 100;
SELECT * FROM transport_types;

-- g.	Get a list of all cities and their countries, including cities for which no countries are specified:
SELECT city_name, country_id
FROM cities;

-- h.	Get a complete list of all types of transport:
SELECT transport_name
FROM transport_types;



